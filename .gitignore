# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime order data — contains real customer PII (name/email/phone/address)
# once the checkout flow has been used; the product catalog seed
# (data/products.json) stays tracked, this generated state does not.
/data/orders.json
/data/notifications.log

# user accounts — credential hashes + PII, never commit
/data/users.json

# runtime store state, auto-seeded on first read (see lib/data/*.server.ts):
# reviews carry customer names; settings carry real bank details;
# messages carry contact-form names and phone numbers.
/data/reviews.json
/data/settings.json
/data/brands.json
/data/messages.json

# customer-uploaded payment proof screenshots
/public/uploads/

# Claude Code: personal/local tool config and vendored skill cache — not
# project source. skills-lock.json (the version-pinning manifest) stays
# tracked; the vendored skill content it resolves to does not.
.claude/settings.local.json
.claude/skills/
.agents/skills/

# local dev server log + Playwright MCP debug artifacts (snapshots, console
# logs, screenshots) — not project source.
.dev-server.log
.playwright-mcp/

.vercel
.env*
!.env.example

# Video masters kept for re-encoding. Large, and git would keep them forever.
data/video-sources/
