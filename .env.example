# Copy to .env.local and fill in real values before deploying.

# --- Canonical site origin (see app/actions/auth.ts) ---
# The origin used to build the links inside verification and password-reset
# emails. Set this in every deployed environment. It must NOT be derived from
# the request's Host header: an attacker who sends a forged Host on a
# password-reset request would otherwise have the victim emailed a valid
# reset token pointing at the attacker's server. No trailing slash.
SITE_URL=https://atoreum.mv

# --- Admin portal (see lib/auth/adminSession.ts) ---
# Shared password for the /admin login screen.
ADMIN_PASSWORD=change-me
# Any long random string, used to sign admin session cookies.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# --- Account email verification (see lib/email.ts, app/actions/auth.ts) ---
# SMTP mailbox that sends verification emails — required for new accounts to
# actually receive their link (registerAction throws without SMTP_USER/PASS).
# Defaults below are GoDaddy Workspace Email's outgoing server; point
# SMTP_HOST/PORT elsewhere for a different provider.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
# Full mailbox address, e.g. sales@yourdomain.com.
SMTP_USER=
# That mailbox's password.
SMTP_PASS=
# Sender shown on verification emails, e.g. "Atoreum MV <sales@yourdomain.com>".
# Leave blank to use "Atoreum MV <SMTP_USER>".
EMAIL_FROM=

# --- File uploads (see lib/storage.ts) ---
# Payment-proof receipts and admin-uploaded product images live in Supabase
# Storage, not the local filesystem (Vercel's is read-only/ephemeral).
# Same project as DATABASE_URL below. Supabase Dashboard -> Project
# Settings -> API -> Project URL / service_role secret key. The service
# role key bypasses Row Level Security — required for server-side uploads
# with no end-user Supabase session; never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Bank transfer details shown at checkout (see lib/bankDetails.ts) ---
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_SWIFT=

# --- Database (see lib/db.ts, lib/data/schema.sql, lib/boli/schema.sql) ---
# A Postgres connection string with both lib/data/schema.sql (products,
# orders, users, reviews, brands, messages, settings) and
# lib/boli/schema.sql (the Boli loyalty ledger) applied — the whole app's
# data layer lives in this one database now. Works identically whether it
# points at a local Postgres instance (`postgresql://postgres:PASSWORD@localhost:5432/atoreum_boli`)
# or a hosted Supabase project's own Postgres connection string (Supabase
# Dashboard -> Project Settings -> Database -> Connection string).
#
# On Supabase specifically, deploying to a serverless host (Vercel or
# similar): use the "Transaction pooler" string (port 6543), NOT "Session
# pooler" (port 5432) — Session mode caps concurrent clients at 15, which
# a serverless deployment blows through almost immediately (many function
# instances, plus the build process itself, connecting at once) and
# throws EMAXCONNSESSION. Transaction mode is Supabase's own documented
# recommendation for serverless, with a much higher client ceiling. Local
# Postgres has no such distinction — this only matters for a pooler URL.
DATABASE_URL=
# Any long random string. Required to call GET /api/cron/boli-expiry
# (Authorization: Bearer <this value>) — point a daily external scheduler
# at that route once this is set.
BOLI_CRON_SECRET=change-me-to-a-long-random-string

# --- Dollar Exchange: Telegram market-rate auto-fetch (see
# lib/telegram/fxRate.server.ts, app/api/cron/fx-rate/route.ts) ---
# From https://my.telegram.org -> API development tools (your own account,
# not a bot -- the rate group is only readable as a member).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generated once by `npx tsx --env-file=.env.local scripts/telegram-login.ts`
# (interactive: your phone number + the code Telegram texts you). Equivalent
# to a saved login for your account -- never commit it.
TELEGRAM_SESSION=
# Any long random string. This exact name is a Vercel reserved variable:
# when set, Vercel automatically sends "Authorization: Bearer <this value>"
# on every request vercel.json's cron entry makes to /api/cron/fx-rate — no
# extra scheduler or manual header setup needed. Also required locally to
# call the route by hand.
CRON_SECRET=change-me-to-a-long-random-string
